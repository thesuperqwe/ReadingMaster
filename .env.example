# ReadingMaster 开发环境默认配置（Phase 0 起步用）。
# 这些值只用于本地开发；部署前必须替换，尤其是密码和密钥。

# 服务端口
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_DB=readingmaster
POSTGRES_USER=readingmaster
POSTGRES_PASSWORD=readingmaster_dev
DATABASE_URL=postgresql+asyncpg://readingmaster:readingmaster_dev@localhost:5432/readingmaster

# Redis
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379/0

# Auth（生产环境务必替换 JWT_SECRET_KEY）
JWT_SECRET_KEY=dev-only-change-me-please-use-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Gateway（Phase 5 才启用，默认 mock 不消耗额度）
AI_PROVIDER=mock
MOCK_AI=true
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# TTS（MVP 用系统 TTS，云 TTS 到 Phase 7）
TTS_PROVIDER=system
