# ReadingMaster 开发环境默认配置（Phase 0 起步用）。
# 这些值只用于本地开发；部署前必须替换，尤其是密码和密钥。

# 服务端口
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_DB=readingmaster
POSTGRES_USER=readingmaster
POSTGRES_PASSWORD=readingmaster_dev
DATABASE_URL=postgresql+asyncpg://readingmaster:readingmaster_dev@localhost:5432/readingmaster

# Redis
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379/0

# Auth（生产环境务必替换 JWT_SECRET_KEY）
JWT_SECRET_KEY=dev-only-change-me-please-use-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Gateway（Phase 5）
# mock 不消耗额度；切换 openai / deepseek 时填写对应 Key。
AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# TTS（使用 Google Cloud TTS；优先 GOOGLE_TTS_ACCESS_TOKEN，旧版 API Key 已不可用于 TTS）
TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_ACCESS_TOKEN=
GOOGLE_TTS_VOICE=en-US-Journey-O
GOOGLE_TTS_SPEAKING_RATE=0.85
GOOGLE_TTS_PITCH=0.0

# ASR（语音转文字，使用硅基流动 SenseVoice，当前免费额度）
ASR_PROVIDER=siliconflow
ASR_API_KEY=
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# OCR（拍照识别实体书）
# OCR_PROVIDER=rapidocr 本地离线 OCR，免费、稳定、无需 API key（推荐）
# OCR_PROVIDER=google 使用 Google Cloud Vision，需启用 Cloud Vision API
# OCR_PROVIDER=siliconflow 使用硅基流动 DeepSeek-OCR（免费但结果不稳定）
# 不填 GOOGLE_OCR_API_KEY 时回退到 GOOGLE_TTS_API_KEY（需确认 Vision API 在同项目已启用）
OCR_PROVIDER=rapidocr
OCR_API_KEY=
OCR_BASE_URL=https://api.siliconflow.cn/v1
OCR_MODEL=deepseek-ai/DeepSeek-OCR
OCR_MAX_SIDE=1600
OCR_RETRIES=3
GOOGLE_OCR_API_KEY=
